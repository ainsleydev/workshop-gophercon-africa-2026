package components

import "workshop/internal/domain/sighting"

templ SightingCard(s sighting.Sighting) {
	<article class="card">
		<div class="card__media">
			if p := Photo(s); p.URL != "" {
				<img src={ Sized(p.URL, "medium") } alt={ Name(s.Species) + " in " + Where(s.Location) } loading="lazy"/>
			} else {
				<div class="card__nophoto">
					@Icon("camera")
					<span>No photo shared</span>
				</div>
			}
			<span class="tag">{ Name(s.Species) }</span>
		</div>
		<div class="card__body">
			<h3>{ Where(s.Location) }</h3>
			<ul class="card__meta">
				<li>
					@Icon("calendar")
					{ s.HappenedAt.Format("2 January 2006") }
				</li>
				if s.IndividualCount != nil {
					<li>
						@Icon("paw")
						{ individuals(*s.IndividualCount) }
					</li>
				}
				if s.RecordedBy != "" {
					<li class="card__observer">
						@Icon("users")
						<span>Seen by { s.RecordedBy }</span>
					</li>
				}
			</ul>
			<a class="link-arrow" href={ templ.URL(RecordURL(s)) } rel="noopener">
				View record
				@Icon("arrow")
			</a>
		</div>
	</article>
}
