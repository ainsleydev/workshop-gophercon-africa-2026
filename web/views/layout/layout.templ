package layout

import "workshop/web/views/components"

type BaseProps struct {
	Title       string
	Description string
}

templ Base(props BaseProps) {
	<!DOCTYPE html>
	<html lang="en-GB">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<link rel="icon" href="/assets/images/logo.svg" type="image/svg+xml"/>
			<link rel="manifest" href="/assets/manifest.json"/>
			<meta name="theme-color" content="#ECEEE8"/>
			<title>{ props.Title }</title>
			if props.Description != "" {
				<meta name="description" content={ props.Description }/>
			}
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@400;500&display=swap"/>
			<link rel="stylesheet" href="/assets/css/app.css"/>
		</head>
		<body id="top">
			<a class="skip-link" href="#content">Skip to content</a>
			<header class="site-header">
				<a class="logo" href="/">
					<img src="/assets/images/logo.svg" alt="" width="36" height="36"/>
					<span>Kenya Wild</span>
				</a>
				<nav class="site-nav" aria-label="Main">
					<a href="/#top">Home</a>
					<a href="/#featured">Featured</a>
					<a href="/#sightings">Sightings</a>
					<a href="/#about">About the data</a>
				</nav>
				<a class="btn btn--lime site-header__cta" href="/#sightings">See the animals</a>
			</header>
			<main id="content">
				{ children... }
			</main>
			<footer class="site-footer">
				<div class="site-footer__brand">
					<a class="logo" href="/">
						<img src="/assets/images/logo.svg" alt="" width="36" height="36"/>
						<span>Kenya Wild</span>
					</a>
					<p>Every lion, rhino and flamingo here was seen and recorded by someone in Kenya.</p>
				</div>
				<div class="site-footer__col">
					<h2>Explore</h2>
					<a href="/#top">Home</a>
					<a href="/#featured">Featured animals</a>
					<a href="/#sightings">All sightings</a>
					<a href="/#about">About the data</a>
				</div>
				<div class="site-footer__col">
					<h2>The data</h2>
					<a href="https://www.gbif.org/country/KE/summary" rel="noopener">GBIF Kenya</a>
					<a href="https://www.gbif.org/what-is-gbif" rel="noopener">What is GBIF?</a>
					<a href="https://www.inaturalist.org" rel="noopener">Record your own</a>
				</div>
				<div class="site-footer__col site-footer__end">
					<span class="site-footer__mark">
						@components.Icon("leaf")
						Made at GopherCon Africa 2026
					</span>
					<p class="site-footer__copy">© 2026 Kenya Wild. Sightings from GBIF.</p>
				</div>
			</footer>
			<script src="/assets/js/app.js"></script>
		</body>
	</html>
}
