package pages

import (
	"strconv"
	"workshop/web/views/components"
	"workshop/web/views/layout"
)

templ Error(message string, code int) {
	@layout.Base(layout.BaseProps{
		Title: "Error " + strconv.Itoa(code),
	}) {
		<section class="panel error-page">
			<p class="eyebrow">
				@components.Icon("leaf")
				Error { strconv.Itoa(code) }
			</p>
			<h1>{ message }</h1>
			<p>
				<a class="link-arrow" href="/">
					Back to the sightings
					@components.Icon("arrow")
				</a>
			</p>
		</section>
	}
}
